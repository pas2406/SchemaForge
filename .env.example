# Modèle de configuration — copie ce fichier en ".env" et remplis tes vraies valeurs.
# ".env" est ignoré par git (jamais commité).

# Clé API Groq (gratuite) — à créer sur https://console.groq.com
GROQ_API_KEY=ta_cle_groq_ici

# Modèle Groq utilisé pour les suggestions (modifiable).
GROQ_MODEL=openai/gpt-oss-20b

# Connexion PostgreSQL pour l'historique des analyses (obligatoire).
DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@localhost:5432/schemaforge
